// Breathnote iOS Compilation Cache (LLVM CAS) & Cross-Worktree Prefix Mapping
//
// Empirically verified invariants on Apple Clang 21 + Swift 6.3:
// 1. Per-worktree DerivedData (`../build/ios-derived-data`) isolates `build.db`,
//    `Build/Intermediates.noindex`, and `Build/Products` per git worktree.
// 2. Global shared CAS (`BREATHNOTE_CAS_CACHE_DIR`) + shared explicit-build
//    `MODULE_CACHE_DIR` eliminates `-module-cache-path` divergence in `swift-frontend`.
// 3. Use scanner-level prefix maps ONLY (`-fdepscan-prefix-map` for Clang,
//    `-scanner-prefix-map` + `-file-compilation-dir /^worktree` for Swift) — never
//    `-ffile-prefix-map` / `-file-prefix-map`, which leak raw worktree paths into `-cc1`.

IPHONEOS_DEPLOYMENT_TARGET = 15.0

BREATHNOTE_CAS_CACHE_DIR = $(HOME)/Library/Developer/Xcode/CompilationCache.noindex

COMPILATION_CACHE_ENABLE_CACHING = YES
COMPILATION_CACHE_CAS_PATH = $(BREATHNOTE_CAS_CACHE_DIR)
COMPILATION_CACHE_KEEP_LOCAL_DIRECTORY = YES
MODULE_CACHE_DIR = $(BREATHNOTE_CAS_CACHE_DIR)/ModuleCache.noindex

// Explicit modules + integrated driver are required by swiftc for `-cache-compile-job`
SWIFT_USE_INTEGRATED_DRIVER = YES
SWIFT_ENABLE_EXPLICIT_MODULES = YES
CLANG_ENABLE_MODULES = YES

// Xcode native SDK, toolchain, DerivedData, and project prefix mapping
CLANG_ENABLE_PREFIX_MAPPING = YES
CLANG_ENABLE_PROJECT_PREFIX_MAPPING = YES
SWIFT_ENABLE_PREFIX_MAPPING = YES
SWIFT_ENABLE_PROJECT_PREFIX_MAPPING = YES

// Dynamic per-worktree root & DerivedData prefix map generated by `scripts/configure_ios_cache.sh`
#include? "WorktreePrefixMap.xcconfig"
